(ns kotobase.nonce-store
  "Bounded, explicitly scoped nonce consumption over immutable blocks and CAS refs.

  This is a hosted storage adapter, not a trusted clock, key registry, global
  consensus or anti-rollback anchor. A failed write can leave an orphan block;
  an ambiguous CAS failure can consume a nonce without admitting the request."
  (:require [kotobase.storage.core :as storage]
            [kotoba.value.codec :as codec]))

(def ^:private limits {:max-bytes 4096 :max-depth 8 :max-items 32})
(defn- reject! [reason]
  (throw (ex-info "nonce store refused" {:kotobase.nonce-store/reason reason})))
(defn- then [v f]
  #?(:clj (f v) :cljs (.then (js/Promise.resolve v) f)))
(defn- bounded-text? [x n] (and (string? x) (<= 1 (count x) n)))

(defn prepare-marker
  "Compute the canonical marker for SCOPE and NONCE without storage effects.

  The result may be staged by a trusted atomic publisher. It grants no
  authority and does not reserve the nonce. Its bytes, ref and scope must be
  bound to the same request and checked by the publication verifier."
  [scope nonce]
  (when-not (bounded-text? scope 512) (reject! :invalid-scope))
  (when-not (bounded-text? nonce 1024) (reject! :invalid-nonce))
  (let [key-value {:format :kotobase.nonce/key-v1 :scope scope :nonce nonce}
        _ (codec/encode-bounded key-value (:max-bytes limits))
        key-cid (codec/value-cid key-value)
        marker {:format :kotobase.nonce/consumed-v1 :key-cid key-cid}
        bytes (codec/encode-bounded marker (:max-bytes limits))
        cid (codec/value-cid marker)]
    {:ref-name (str "nonce/v1/" key-cid) :marker-cid cid :marker marker :bytes bytes}))

(defn- verify-marker! [backend {:keys [marker-cid marker]}]
  (then (storage/-get-blocks backend [marker-cid])
        (fn [blocks]
          (let [stored (get blocks marker-cid)]
            (when-not (and stored (= marker (codec/verify-value-cid-structurally-bounded marker-cid stored limits)))
              (reject! :invalid-marker)))
          true)))

(defn- available-prepared? [backend {:keys [ref-name marker-cid] :as prepared}]
  (then (storage/-read-ref backend ref-name)
        (fn [current]
          (if (nil? current) true
            (do
              (when-not (and (map? current) (= marker-cid (:cid current)))
                (reject! :invalid-nonce-ref))
              (then (verify-marker! backend prepared) (fn [_] false)))))))

(defn available?
  "Read-only, non-reserving observation of a nonce, returning bool or Promise.

  True can become stale immediately. Never treat it as admission: before any
  result is released, a trusted publisher must atomically recheck the absent
  ref and publish the exact marker and receipt under the same local root."
  [backend scope nonce]
  (storage/validate-backend! backend)
  (available-prepared? backend (prepare-marker scope nonce)))

(defn consumer
  "Build a one-shot `(fn [nonce] boolean-or-Promise)` for authority-window.

  SCOPE is a host-controlled, stable authority/tenant/principal namespace;
  changes create a different replay domain. A single-writer ref backend needs
  explicit :single-writer? true AND externally enforced writer exclusivity.
  The adapter cannot detect rollback, ref deletion or a dishonest backend. It
  never recycles refs and offers no retention/GC protocol. An existing ref is
  checked against its marker before replay is refused without a block write."
  [{:keys [backend scope single-writer?] :as options}]
  (when-not (and (map? options) (= #{:backend :scope :single-writer?} (set (keys options)))
                 (bounded-text? scope 512) (boolean? single-writer?))
    (reject! :invalid-options))
  (storage/validate-backend! backend)
  (when (and (= :single-writer-ref (storage/ref-profile backend)) (not single-writer?))
    (reject! :single-writer-not-asserted))
  (fn [nonce]
    (let [{:keys [ref-name marker-cid bytes] :as prepared} (prepare-marker scope nonce)]
      (then (available-prepared? backend prepared)
            (fn [available]
              (if-not available false
                (then (storage/-put-blocks! backend [{:cid marker-cid :bytes bytes}])
                      (fn [_]
                        (then (verify-marker! backend prepared)
                              (fn [_]
                                (then (storage/-compare-and-set-ref! backend ref-name nil marker-cid)
                                      (fn [result]
                                        (when-not (and (map? result) (boolean? (:published? result))
                                                       (= marker-cid (:current result)))
                                          (reject! :invalid-cas-result))
                                        (true? (:published? result))))))))))))))
