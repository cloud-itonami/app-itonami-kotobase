(ns nonce-store-async (:require [kotobase.nonce-store :as n] [kotobase.storage.memory :as m]))
(def backend (m/memory-store))
(defn consumer [scope] (n/consumer {:backend backend :scope scope :single-writer? false}))
(defn ensure! [v m] (when-not v (throw (js/Error. m))))
(defn -main []
 (-> ((consumer "a") "one")
  (.then (fn [v] (ensure! (true? v) "first denied") ((consumer "a") "one")))
  (.then (fn [v] (ensure! (false? v) "replay accepted") ((consumer "b") "one")))
  (.then (fn [v] (ensure! (true? v) "scope collision")
           (js/Promise.all #js [((consumer "a") "race") ((consumer "a") "race")])))
  (.then (fn [v] (ensure! (= #{true false} (set (array-seq v))) "race accepted twice")
           (println "CLJS nonce store: persistence, scope and CAS race pass")))
  (.catch (fn [e] (.error js/console e) (set! (.-exitCode js/process) 1)))))
(set! *main-cli-fn* -main)
