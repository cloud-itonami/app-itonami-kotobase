{:paths ["src"]
 ;; Two surfaces live here. `kotobase.core` is the Datomic-shaped database API
 ;; — open/head/transact!/datoms/q/query/pull — on JVM (core.clj) and as
 ;; Promises for Workers (core.cljs), delegating to kotobase-engine over the
 ;; provider-neutral storage contract. The older IStore port + pure LocalStore +
 ;; KotobaseStore (which talks to kotobase.net through a HOST-INJECTED `xrpc`
 ;; fn — no HTTP client baked in, so it runs unchanged on JVM / cljs / a
 ;; Cloudflare Worker / kotoba-WASM) remain for compatibility; new persistence
 ;; targets `kotobase.core`.
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.error"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced java.nio.file.Files here (2026-09-24). An explicit
        ;; floor: temp-dir temp-file read-all-bytes write-bytes write-string
        ;; delete-if-exists are in kotoba.io from this sha, and tools.deps takes
        ;; the NEWEST sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/security
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.security"}
        io.github.kotoba-lang/abi
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.abi"}
        io.github.kotoba-lang/identity
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.identity"}
        io.github.kotoba-lang/grant
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.grant"}
        ;; The transitive arrangement/prolly path still names eec3ee8, whose
        ;; reader-conditional ns form is not valid under the real
        ;; ClojureScript compiler. Keep the Worker build on the fleet's
        ;; qualified io-multiformats pin; this is a direct compile boundary,
        ;; not a second implementation of CID primitives.
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.ioMultiformats"}
        ;; `kotoba.value.codec` — the canonical `kotoba.value.v1` codec and the
        ;; CIDv1 DAG-CBOR logical address of an admitted value. Direct because
        ;; `kotobase.execution-identity` names it: the execution contract's
        ;; identifiers are recomputed from the records rather than accepted
        ;; from a caller, and that needs one canonical codec rather than
        ;; whichever one a transitive path happens to select. Pinned to the sha
        ;; the resolver already selects here, so no new diamond is introduced;
        ;; it is `identical` to io-ipld's main.
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.ioIpld"}
        ;; kotobase.core delegates to the engine, which speaks the
        ;; provider-neutral storage contract. Concrete providers (postgres, d1,
        ;; s3, ipfs, sqlite) are chosen by the host and passed in as `:storage`;
        ;; none of them are dependencies here.
        io.github.kotoba-lang/kotobase-storage
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaseStorage"}
        io.github.kotoba-lang/kotobase-engine
        {:git/url "https://github.com/kotoba-lang/kotobase-engine.git"
         :git/sha "b8b163e889341cdf49217570380872e0575fcbdd"}}
 :aliases
 {:cljs-test {:extra-paths ["test"]
              :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :integration {:extra-paths ["test-integration"]
                :extra-deps {io.github.kotoba-lang/kotoba
                             {:local/root "../kotoba"}
                             io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                :main-opts ["-m" "cognitect.test-runner" "-d" "test-integration"]}
  :cid-conformance
  {:replace-paths ["src" "qualification"]
   :replace-deps
   {org.clojure/clojure {:mvn/version "1.12.0"}
    io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/gov.nist.sha2"}
    io.github.kotoba-lang/compiler
    {:git/url "https://github.com/kotoba-lang/compiler.git"
     :git/sha "3febafca47ec89eb7167a7756cdd3fd579686dc3"}
    io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "qualification"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
